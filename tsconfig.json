{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"],
      "@/*": ["./*"]
    },
    "target": "ES2020",
    "module": "esnext",           // ✅ use esnext or es2015
    "moduleResolution": "bundler", // ✅ use bundler
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "src"
  ]
}